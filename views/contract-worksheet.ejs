<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contract Worksheet - Talent-Hub</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Blue Theme Colors */
            --primary-blue: #2563eb;
            --light-blue-bg: #eff6ff;
            --border-blue: #bfdbfe;

            --text-dark: #1f2937;
            --text-light: #6b7280;
            --border-gray: #e5e7eb;
            --bg-gray: #f9fafb;
            --success-green: #10b981;
            --success-bg: #d1fae5;

            --dark-blue: #0b1a3d;
        }

        /* Optimized for Puppeteer PDF Generation */
        body {
            background-color: white;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* A4 Page Styling for Print */
        .page {
            width: 210mm;
            height: 297mm;
            margin: 0 auto;
            position: relative;
            box-sizing: border-box;
            padding: 40px 50px 0 50px;
            display: flex;
            flex-direction: column;
            page-break-after: always;
            break-after: page;
            overflow: hidden;
            background: white;
        }

        .page:last-child {
            page-break-after: auto;
            break-after: auto;
        }

        /* Header Layout */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 25px;
        }

        /* Logo Area */
        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-img {
            height: 70px;
            object-fit: contain;
        }

        .logo-text {
            display: flex;
            flex-direction: column;
        }

        .logo-text h1 {
            margin: 0;
            font-size: 28px;
            color: var(--primary-blue);
            font-weight: 700;
        }

        .logo-text p {
            margin: 2px 0 0 0;
            font-size: 11px;
            color: var(--primary-blue);
            font-weight: 500;
        }

        .logo-text .divider {
            width: 100%;
            height: 2px;
            background-color: var(--primary-blue);
            margin-top: 5px;
        }

        /* Header Right Meta */
        .header-meta {
            text-align: right;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            min-width: 280px;
            /* prevent wrapping */
        }

        .header-meta h2 {
            margin: 0 0 8px 0;
            font-size: 22px;
            color: var(--dark-blue);
            text-transform: uppercase;
        }

        .header-meta .contract-badge {
            background-color: var(--light-blue-bg);
            color: var(--primary-blue);
            padding: 6px 14px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .date-row {
            display: flex;
            gap: 25px;
            justify-content: flex-end;
        }

        .date-item {
            display: flex;
            align-items: center;
            gap: 8px;
            text-align: left;
        }

        .date-item .icon {
            color: var(--text-light);
            font-size: 16px;
        }

        .date-text h5 {
            margin: 0;
            font-size: 10px;
            color: var(--text-dark);
            font-weight: 600;
        }

        .date-text p {
            margin: 2px 0 0 0;
            font-size: 11px;
            color: var(--text-dark);
            font-weight: 700;
        }

        /* Summary Banner */
        .summary-banner {
            border: 1px solid var(--border-blue);
            border-radius: 12px;
            padding: 15px;
            background-color: var(--bg-gray);
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            margin-bottom: 25px;
        }

        .summary-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            border-right: 1px solid var(--border-gray);
            padding-right: 15px;
            flex: 1;
        }

        .summary-item:last-child {
            border-right: none;
            padding-right: 0;
            padding-left: 5px;
        }

        .summary-icon {
            width: 32px;
            height: 32px;
            background-color: var(--primary-blue);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
            flex-shrink: 0;
        }

        .item-text h5 {
            margin: 0 0 4px 0;
            font-size: 10px;
            color: var(--primary-blue);
            font-weight: 600;
        }

        .item-text p {
            margin: 0;
            font-size: 11px;
            color: var(--text-dark);
            font-weight: 600;
            line-height: 1.3;
        }

        .item-text span.sub {
            font-size: 9px;
            color: var(--text-light);
            font-weight: 400;
            display: block;
            margin-top: 2px;
        }

        .total-item .summary-icon {
            background-color: var(--success-green);
        }

        .total-item .item-text h5 {
            color: var(--success-green);
        }

        .total-item .item-text p {
            font-size: 14px;
            font-weight: 700;
        }

        .active-badge {
            display: inline-block;
            background-color: var(--success-bg);
            color: var(--success-green);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: 600;
            margin-top: 4px;
        }

        /* Section Title */
        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            color: var(--dark-blue);
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
        }

        /* Vertical Timeline */
        .timeline-container {
            margin-bottom: 25px;
            position: relative;
        }

        /* The connecting vertical line */
        .timeline-container::before {
            content: '';
            position: absolute;
            left: 14px;
            /* Center of the 30px node */
            top: 45px;
            /* Below the header */
            bottom: 30px;
            width: 2px;
            background-color: var(--primary-blue);
            z-index: 1;
        }

        .timeline-header {
            display: flex;
            gap: 20px;
            margin-bottom: 10px;
            border-bottom: 1px solid var(--border-gray);
            padding-bottom: 10px;
        }

        .timeline-header-node {
            width: 30px;
            /* Matches node width */
            flex-shrink: 0;
        }

        .timeline-header-cols {
            flex: 1;
            display: grid;
            grid-template-columns: 1.5fr 2.5fr 1.5fr 1.2fr 1.2fr;
            font-size: 9px;
            color: var(--text-light);
            text-transform: uppercase;
            font-weight: 600;
            padding: 0 15px;
            gap: 10px;
        }

        .timeline-row {
            display: flex;
            gap: 20px;
            margin-bottom: 12px;
            position: relative;
        }

        .node-col {
            width: 30px;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
        }

        .node-circle {
            width: 30px;
            height: 30px;
            background-color: var(--primary-blue);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
            font-weight: 700;
            z-index: 2;
            margin-top: 15px;
            /* Align roughly with first line of text */
        }

        .timeline-card {
            flex: 1;
            display: grid;
            grid-template-columns: 1.5fr 2.5fr 1.5fr 1.2fr 1.2fr;
            align-items: center;
            border: 1px solid var(--border-gray);
            border-radius: 8px;
            padding: 12px 15px;
            background: white;
            gap: 10px;
        }

        .milestone-desc h4 {
            margin: 0 0 4px 0;
            font-size: 11px;
            color: var(--text-dark);
        }

        .phase-badge {
            background-color: var(--light-blue-bg);
            color: var(--primary-blue);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 9px;
            display: inline-block;
            font-weight: 600;
        }

        .milestone-desc p.sub {
            margin: 4px 0 0 0;
            font-size: 10px;
            color: var(--text-light);
            line-height: 1.3;
        }

        .milestone-date {
            display: flex;
            align-items: flex-start;
            gap: 6px;
        }

        .milestone-date .icon {
            color: var(--text-light);
            font-size: 12px;
            margin-top: 1px;
        }

        .milestone-date p.main {
            margin: 0;
            font-size: 10px;
            color: var(--text-dark);
            font-weight: 600;
        }

        .milestone-date p.sub {
            margin: 2px 0 0 0;
            font-size: 9px;
            color: var(--text-light);
            line-height: 1.3;
        }

        .milestone-amount h4 {
            margin: 0;
            font-size: 11px;
            color: var(--text-dark);
        }

        .milestone-amount p {
            margin: 2px 0 0 0;
            font-size: 9px;
            color: var(--text-light);
        }

        .milestone-status {
            text-align: right;
        }

        .status-badge {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;
            font-size: 10px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .status-badge.completed {
            color: var(--success-green);
        }

        .status-sub {
            font-size: 9px;
            color: var(--text-light);
            line-height: 1.3;
        }

        /* Two Column Lower Section */
        .lower-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .box {
            border: 1px solid var(--border-blue);
            border-radius: 12px;
            padding: 15px 20px;
            background-color: var(--light-blue-bg);
        }

        .box-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            font-size: 11px;
            font-weight: 700;
            color: var(--dark-blue);
            text-transform: uppercase;
        }

        /* Payment Summary Data */
        .payment-summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            text-align: center;
            margin-bottom: 10px;
        }

        .payment-val p.label {
            margin: 0 0 4px 0;
            font-size: 9px;
            color: var(--text-dark);
            font-weight: 600;
        }

        .payment-val p.amount {
            margin: 0;
            font-size: 12px;
            color: var(--primary-blue);
            font-weight: 700;
        }

        .payment-val p.amount.paid {
            color: var(--success-green);
        }

        /* Circular Progress */
        .progress-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 10px;
        }

        .progress-wrapper p {
            margin: 0 0 5px 0;
            font-size: 9px;
            color: var(--text-dark);
            font-weight: 600;
        }

        .progress-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: conic-gradient(var(--primary-blue) 100%, #e5e7eb 0);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .progress-inner {
            width: 40px;
            height: 40px;
            background-color: var(--light-blue-bg);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            color: var(--dark-blue);
        }

        /* Notes List */
        .notes-list {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .notes-list li {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            font-size: 10px;
            color: var(--text-dark);
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .notes-list li .icon {
            color: var(--success-green);
            flex-shrink: 0;
            margin-top: 2px;
        }

        /* Footer Signatures */
        .footer-signatures {
            border: 1px solid var(--border-blue);
            border-radius: 12px;
            background-color: white;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            padding: 15px 20px;
            margin-bottom: 15px;
        }

        .sig-block {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .sig-icon {
            width: 32px;
            height: 32px;
            background-color: var(--primary-blue);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
            flex-shrink: 0;
        }

        .sig-details p.for {
            margin: 0 0 6px 0;
            font-size: 10px;
            color: var(--primary-blue);
            font-weight: 600;
        }

        .sig-img {
            height: 24px;
            font-family: 'Brush Script MT', cursive;
            font-size: 20px;
            color: var(--text-dark);
            margin-bottom: 4px;
            border-bottom: 1px solid var(--border-gray);
            width: 100%;
            display: inline-block;
        }

        .sig-details p.role {
            margin: 4px 0 2px 0;
            font-size: 9px;
            color: var(--text-light);
        }

        .sig-details p.date {
            margin: 0;
            font-size: 9px;
            color: var(--text-dark);
            font-weight: 500;
        }

        .verified-stamp {
            width: 70px;
            height: 70px;
            border: 2px dashed var(--primary-blue);
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--primary-blue);
            position: relative;
        }

        .verified-stamp::before {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            right: 2px;
            bottom: 2px;
            border: 1px solid var(--primary-blue);
            border-radius: 50%;
        }

        .verified-stamp h4 {
            margin: 0;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .verified-stamp p {
            margin: 2px 0 0 0;
            font-size: 6px;
            text-transform: uppercase;
        }

        /* Bottom Dark Strip */
        .bottom-dark-strip {
            background-color: var(--dark-blue);
            color: white;
            padding: 15px 50px;
            font-size: 10px;
            margin-top: auto;
            margin-left: -50px;
            margin-right: -50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .bottom-dark-strip .left-text {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .bottom-dark-strip .center-text {
            color: var(--border-gray);
        }

        .bottom-dark-strip .right-text {
            display: flex;
            align-items: center;
            gap: 6px;
        }
    </style>
</head>

<body>

    <div class="page">

        <!-- Header Section -->
        <div class="header">
            <div class="logo-container">
                <img src="../public/logo 2.png" alt="Talent Hub Logo" class="logo-img">

            </div>

            <div class="header-meta">
                <h2>CONTRACT TIMELINE</h2>
                <div class="contract-badge">CONTRACT ID: CON-2025-0426</div>

                <div class="date-row">
                    <div class="date-item">
                        <span class="icon">&#128197;</span>
                        <div class="date-text">
                            <h5>Start Date</h5>
                            <p>May 23, 2025</p>
                        </div>
                    </div>
                    <div class="date-item">
                        <span class="icon">&#127937;</span>
                        <div class="date-text">
                            <h5>End Date</h5>
                            <p>Nov 23, 2025</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Banner -->
        <div class="summary-banner">
            <div class="summary-item">
                <div class="summary-icon">&#128188;</div>
                <div class="item-text">
                    <h5>Client</h5>
                    <p>TechNova Solutions Pvt. Ltd.</p>
                </div>
            </div>

            <div class="summary-item">
                <div class="summary-icon">&#128100;</div>
                <div class="item-text">
                    <h5>Freelancer</h5>
                    <p>Siva Prasad Kurra<span class="sub">Angular Developer</span></p>
                </div>
            </div>

            <div class="summary-item">
                <div class="summary-icon">&#128221;</div>
                <div class="item-text">
                    <h5>Project</h5>
                    <p>E-commerce Web Application</p>
                </div>
            </div>

            <div class="summary-item total-item">
                <div class="summary-icon">&#8377;</div>
                <div class="item-text">
                    <h5>Total Contract Value</h5>
                    <p>₹ 75,000.00</p>
                    <div class="active-badge">Completed</div>
                </div>
            </div>
        </div>

        <!-- Contract Milestones Title -->
        <div class="section-header">
            <span>&#9776;</span> CONTRACT MILESTONES
        </div>

        <!-- Vertical Timeline -->
        <div class="timeline-container">

            <div class="timeline-header">
                <div class="timeline-header-node"></div>
                <div class="timeline-header-cols">
                    <div>Milestone</div>
                    <div>Description</div>
                    <div>Due Date</div>
                    <div>Amount</div>
                    <div style="text-align: right;">Status</div>
                </div>
            </div>

            <!-- Milestone 1 -->
            <div class="timeline-row">
                <div class="node-col">
                    <div class="node-circle">01</div>
                </div>
                <div class="timeline-card">
                    <div>
                        <div class="milestone-desc">
                            <h4>Milestone 1</h4>
                            <div class="phase-badge">Phase 1</div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-desc">
                            <h4>Requirement Analysis & Planning</h4>
                            <p class="sub">Gather requirements and create project plan</p>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-date">
                            <span class="icon">&#128197;</span>
                            <div>
                                <p class="main">May 23, 2025</p>
                                <p class="sub">Completed on<br>May 23, 2025</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-amount">
                            <h4>₹ 15,000.00</h4>
                            <p>20% of total</p>
                        </div>
                    </div>
                    <div class="milestone-status">
                        <div class="status-badge completed"><span>&#10004;</span> Completed</div>
                        <div class="status-sub">Paid on<br>May 23, 2025</div>
                    </div>
                </div>
            </div>

            <!-- Milestone 2 -->
            <div class="timeline-row">
                <div class="node-col">
                    <div class="node-circle">02</div>
                </div>
                <div class="timeline-card">
                    <div>
                        <div class="milestone-desc">
                            <h4>Milestone 2</h4>
                            <div class="phase-badge">Phase 2</div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-desc">
                            <h4>UI/UX Design</h4>
                            <p class="sub">Design system, wireframes and user interface</p>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-date">
                            <span class="icon">&#128197;</span>
                            <div>
                                <p class="main">Jun 23, 2025</p>
                                <p class="sub">Completed on<br>Jun 20, 2025</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-amount">
                            <h4>₹ 15,000.00</h4>
                            <p>20% of total</p>
                        </div>
                    </div>
                    <div class="milestone-status">
                        <div class="status-badge completed"><span>&#10004;</span> Completed</div>
                        <div class="status-sub">Paid on<br>Jun 20, 2025</div>
                    </div>
                </div>
            </div>

            <!-- Milestone 3 -->
            <div class="timeline-row">
                <div class="node-col">
                    <div class="node-circle">03</div>
                </div>
                <div class="timeline-card">
                    <div>
                        <div class="milestone-desc">
                            <h4>Milestone 3</h4>
                            <div class="phase-badge">Phase 3</div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-desc">
                            <h4>Frontend Development</h4>
                            <p class="sub">Implement UI and frontend functionality</p>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-date">
                            <span class="icon">&#128197;</span>
                            <div>
                                <p class="main">Aug 23, 2025</p>
                                <p class="sub">Completed on<br>Aug 18, 2025</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-amount">
                            <h4>₹ 22,500.00</h4>
                            <p>30% of total</p>
                        </div>
                    </div>
                    <div class="milestone-status">
                        <div class="status-badge completed"><span>&#10004;</span> Completed</div>
                        <div class="status-sub">Paid on<br>Aug 18, 2025</div>
                    </div>
                </div>
            </div>

            <!-- Milestone 4 -->
            <div class="timeline-row">
                <div class="node-col">
                    <div class="node-circle">04</div>
                </div>
                <div class="timeline-card">
                    <div>
                        <div class="milestone-desc">
                            <h4>Milestone 4</h4>
                            <div class="phase-badge">Phase 4</div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-desc">
                            <h4>Backend Development</h4>
                            <p class="sub">APIs, database and server integration</p>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-date">
                            <span class="icon">&#128197;</span>
                            <div>
                                <p class="main">Oct 23, 2025</p>
                                <p class="sub">Completed on<br>Oct 15, 2025</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="milestone-amount">
                            <h4>₹ 15,000.00</h4>
                            <p>20% of total</p>
                        </div>
                    </div>
                    <div class="milestone-status">
                        <div class="status-badge completed"><span>&#10004;</span> Completed</div>
                        <div class="status-sub">Paid on<br>Oct 15, 2025</div>
                    </div>
                </div>
            </div>

            <!-- Milestone 5 -->
            <div class="timeline-row">
                <div class="node-col">
                    <div class="node-circle">05</div>
                </div>
                <div class="timeline-card">
                    <div>
                        <div class="milestone-desc">
                            <h4>Milestone 5</h4>
                            <div class="phase-badge">Phase 5</div>
                        </div>
